# Copy to worker.env, fill every secret, then chmod 600.
# This file is read only by pv-wiki-worker, not by n8n.

# Read-only source catalogue. This is not the n8n or Wiki.js database.
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=products
PGUSER=products_readonly
PGPASSWORD=
# Prefer verify-full. Explicit disable/allow/prefer are supported only when
# the catalogue cannot use TLS and the operator accepts the network risk.
PGSSLMODE=verify-full
# Used by verify-ca/verify-full; non-verifying modes ignore this path.
PGSSLROOTCERT=/run/pv-wiki/catalogue-ca.pem

# Exa supports one key or a comma/whitespace-separated rotation set.
EXA_API_KEYS=

# User-selected OpenAI-compatible Chat Completions provider.
# AI_BASE_URL is the API base path; /chat/completions is added by the worker.
# Keep HTTPS unless an explicitly trusted private HTTP endpoint requires opt-in.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=
AI_ALLOW_INSECURE_HTTP=false
# DeepSeek thinking mode over full datasheet evidence may require the 300-second
# supported maximum; shorter non-reasoning providers can use a lower value.
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096
# Enable only when the selected provider/model supports JSON response mode.
AI_JSON_RESPONSE_FORMAT=false
# Optional provider extension: enabled or disabled. Leave empty to omit the
# `thinking` request field and preserve the provider's default behavior.
AI_THINKING_MODE=
# Optional thinking effort extension: high is the shortest DeepSeek-supported
# setting; max allows more reasoning. Leave empty for provider compatibility.
AI_REASONING_EFFORT=
AI_MAX_EVIDENCE_CHARS=80000

# Existing Wiki.js instance. Wiki.js owns a separate database.
WIKIJS_URL=https://wiki.example.com
WIKIJS_TOKEN=
WIKIJS_LOCALE=zh-cn
WIKIJS_PATH_PREFIX=products
WIKIJS_HOME_PATH=home
WIKIJS_HOME_TITLE=GTI 产品百科
WIKIJS_NEW_PAGE_PRIVATE=true
WIKIJS_NEW_PAGE_PUBLISHED=false

# Share this value only with the n8n "PV Wiki Worker" Header Auth credential.
PV_WIKI_WORKER_TOKEN=
# Dedicated PostgreSQL state database. URL-encode reserved password characters.
# Keep the server private and attach the worker to its Docker network.
PV_WIKI_STATE_DATABASE_URL=postgresql://pv_wiki_app:password@postgres:5432/pv_wiki_state
PV_WIKI_AUTO_PUBLISH_MIN_CONFIDENCE=0.85
PV_WIKI_MIN_FACT_CONFIDENCE=0.80
# Deprecated compatibility switch. Mirrors may assist discovery, but never
# satisfy the automatic publication gate.
PV_WIKI_ALLOW_MIRRORS=false
# Optional deployment overrides for the bundled versioned suppliers.json
# brand/manufacturer registry.
PV_WIKI_PUBLIC_BRAND_ALIASES_JSON=
# Optional override keyed by catalogue brand_code or its exact public alias.
# The bundled registry already covers normal global/B2B/regional official
# hosts. AI output cannot select or replace either operator-owned mapping.
# If no entry matches, the runtime can verify an HTTPS manufacturer host from
# the AI-discovered manufacturer plus extracted manufacturer/full-model text,
# an independent HTTPS identity extract. Facts are quoted from the verified
# primary datasheet rather than duplicated on both domains.
# Failure is recorded as source_unverified and retried without opening an issue.
PV_WIKI_TRUSTED_SOURCE_DOMAINS_JSON=
# Opt in only when model-shaped product_id values are safe public search hints.
# The worker rejects whitespace/company-like IDs and sends only the explicit
# public manufacturer alias above, never raw brand_code.
PV_WIKI_SEARCH_INCLUDE_INTERNAL_HINTS=false
PV_WIKI_MAX_EXTRACT_CHARS=30000
# Required evidence path for automatic publication. HTTPS is DNS-pinned after
# public-address validation; bytes stay in memory and parsing runs in a bounded
# child process. Disabling it keeps discovery available but automatic
# publication fails closed because no original PDF can be runtime-verified.
PV_WIKI_PDF_DIRECT_FETCH=true
PV_WIKI_PDF_MAX_FILES=2
PV_WIKI_PDF_MAX_BYTES=12000000
PV_WIKI_PDF_MAX_PAGES=80
PV_WIKI_PDF_DOWNLOAD_TIMEOUT_SECONDS=20
PV_WIKI_PDF_PARSE_TIMEOUT_SECONDS=15
# Bounded inner research agent: initial pass plus at most two supplemental passes.
PV_WIKI_RESEARCH_MAX_ROUNDS=3
PV_WIKI_RESEARCH_MAX_QUERIES=7
# Minimum 3. Search reserves 1 normalized unit/query and Extract reserves
# 2 units/batch before the call starts.
PV_WIKI_RESEARCH_MAX_CREDITS=20
# No new research action starts after this deadline; the worker lease also
# includes a bounded provider/Wiki completion tail.
PV_WIKI_RESEARCH_MAX_SECONDS=600
# Optional UTC stop-loss limits across all products; zero disables a window.
# These count audited Exa Search/Extract units only, not AI tokens or currency.
# Keep provider-account AI spend limits and alerts enabled separately.
PV_WIKI_GLOBAL_DAILY_CREDIT_LIMIT=0
PV_WIKI_GLOBAL_MONTHLY_CREDIT_LIMIT=0
PV_WIKI_HTTP_TIMEOUT=30
