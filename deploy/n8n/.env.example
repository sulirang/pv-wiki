# Copy to deploy/n8n/.env and chmod 600 before starting the stack.
# Deliberately pin n8n, then upgrade only after reviewing release notes.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.26.8
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2.10-alpine

N8N_DOMAIN=n8n.example.com
N8N_PORT=5678
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=

# Host path to the CA that validates the catalogue PostgreSQL server. The
# system bundle works for a public CA; point to a private CA PEM when needed.
# The read-only mount remains harmless and is ignored by non-verifying modes.
CATALOGUE_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Existing private Docker network containing the dedicated PV Wiki PostgreSQL
# state database.
PV_WIKI_STATE_NETWORK=

# Used only by compose.existing-n8n.yaml.
N8N_EXTERNAL_NETWORK=
