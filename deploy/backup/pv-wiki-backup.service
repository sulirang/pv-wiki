[Unit]
Description=Back up PV Wiki and n8n state
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/pv-wiki-backup
ExecStart=/usr/local/sbin/pv-wiki-backup
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
