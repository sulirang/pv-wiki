{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pv-wiki/decision.schema.json",
  "title": "PV wiki product decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "lease_token",
    "outcome",
    "confidence",
    "decision_notes",
    "datasheets",
    "sources",
    "facts",
    "conflicts"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "product_id": {"type": "string", "minLength": 1},
    "lease_token": {"type": "string", "minLength": 16},
    "outcome": {
      "enum": ["publish", "no_datasheet", "ambiguous", "insufficient_identity"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "manufacturer": {"type": "string"},
    "model": {"type": "string"},
    "product_category": {"type": "string", "maxLength": 100},
    "summary": {"type": "string", "maxLength": 2000},
    "review_summary": {"type": "string", "maxLength": 1500},
    "review_evidence_urls": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "format": "uri"}
    },
    "decision_notes": {"type": "string", "minLength": 1, "maxLength": 1000},
    "datasheets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "source_type", "is_primary"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": ["manufacturer", "regulatory", "authorized", "mirror", "community"]
          },
          "is_primary": {"type": "boolean"}
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "source_type"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": ["manufacturer", "regulatory", "authorized", "mirror", "community"]
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "confidence",
          "evidence_urls",
          "evidence_quotes"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "maxLength": 100},
          "value": {"type": ["string", "number", "boolean"]},
          "unit": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0.8, "maximum": 1},
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri"}
          },
          "evidence_quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "quote"],
              "properties": {
                "url": {"type": "string", "format": "uri"},
                "quote": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "values", "source_urls"],
        "properties": {
          "field": {"type": "string"},
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {"type": ["string", "number", "boolean"]}
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "publish"}},
        "required": ["outcome"]
      },
      "then": {
        "required": ["product_category", "summary"],
        "properties": {
          "product_category": {"minLength": 1},
          "summary": {"minLength": 1},
          "datasheets": {"minItems": 1},
          "facts": {"minItems": 5}
        }
      }
    }
  ]
}
