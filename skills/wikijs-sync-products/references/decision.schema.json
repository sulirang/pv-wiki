{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pv-wiki/decision.schema.json",
  "title": "PV wiki product decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "lease_token",
    "outcome",
    "confidence",
    "decision_notes",
    "datasheets",
    "sources",
    "datasheet_parameters",
    "facts",
    "derived_insights",
    "conflicts"
  ],
  "$defs": {
    "scalar": {
      "type": ["string", "number", "boolean"]
    },
    "evidenceQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "quote"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 500},
        "model_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Optional exact Markdown, TSV, or fixed-width PDF-layout model header row paired with quote as the same-table parameter row."
        }
      }
    },
    "groundedEvidence": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "value": {"$ref": "#/$defs/scalar"},
        "unit": {"type": "string", "maxLength": 80},
        "confidence": {"type": "number", "minimum": 0.8, "maximum": 1},
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uri"}
        },
        "evidence_quotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/evidenceQuote"}
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1"},
    "product_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "lease_token": {"type": "string", "minLength": 16, "maxLength": 200},
    "outcome": {
      "enum": [
        "publish",
        "no_datasheet",
        "ambiguous",
        "insufficient_identity",
        "out_of_scope"
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "manufacturer": {"type": "string", "maxLength": 300},
    "manufacturer_zh": {"type": "string", "maxLength": 200},
    "model": {"type": "string", "maxLength": 300},
    "product_description_zh": {"type": "string", "maxLength": 200},
    "display_title_zh": {
      "type": "string",
      "maxLength": 200,
      "description": "Legacy compatibility field; new decisions use product_description_zh."
    },
    "product_category_code": {
      "enum": [
        "pv_cell",
        "pv_module",
        "energy_storage_battery",
        "inverter",
        "energy_storage_system",
        "heat_pump",
        "ev_charging",
        "power_electronics",
        "thermal_equipment",
        "solar_equipment",
        "accessory",
        "other"
      ]
    },
    "product_category": {
      "enum": [
        "光伏电池",
        "光伏组件",
        "储能电池",
        "逆变器",
        "储能系统",
        "热泵",
        "充电设备",
        "电力电子设备",
        "热能设备",
        "光伏设备",
        "配件",
        "其他"
      ]
    },
    "product_type": {"type": "string", "maxLength": 100},
    "summary": {"type": "string", "maxLength": 2000},
    "review_summary": {"type": "string", "maxLength": 1500},
    "review_evidence_urls": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "format": "uri"}
    },
    "classification_evidence_urls": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "classification_evidence_quotes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "quote"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "quote": {"type": "string", "minLength": 8, "maxLength": 500}
        }
      }
    },
    "decision_notes": {"type": "string", "minLength": 1, "maxLength": 1000},
    "datasheets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "source_type", "is_primary"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": ["manufacturer", "regulatory", "authorized", "mirror", "community"]
          },
          "is_primary": {"type": "boolean"}
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "source_type"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": ["manufacturer", "regulatory", "authorized", "mirror", "community"]
          }
        }
      }
    },
    "datasheet_parameters": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/groundedEvidence"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "confidence",
              "evidence_urls",
              "evidence_quotes"
            ],
            "properties": {
              "name": true,
              "name_zh": {"type": "string", "maxLength": 200},
              "section": {"type": "string", "maxLength": 100},
              "section_zh": {"type": "string", "maxLength": 100},
              "subsection": {"type": "string", "maxLength": 100},
              "subsection_zh": {"type": "string", "maxLength": 100},
              "value": true,
              "value_zh": {"type": "string", "maxLength": 200},
              "unit": true,
              "confidence": true,
              "evidence_urls": true,
              "evidence_quotes": true
            }
          }
        ]
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/groundedEvidence"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "confidence",
              "evidence_urls",
              "evidence_quotes"
            ],
            "properties": {
              "name": true,
              "category": {"type": "string", "maxLength": 100},
              "value": true,
              "unit": true,
              "confidence": true,
              "evidence_urls": true,
              "evidence_quotes": true
            }
          }
        ]
      }
    },
    "derived_insights": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "formula", "basis"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "value": {"type": "number"},
          "unit": {"type": "string", "maxLength": 80},
          "formula": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[ \\t]*[-+]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][-+]?\\d+)?[ \\t]*[-+*/×÷][ \\t]*[-+]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][-+]?\\d+)?[ \\t]*$"
          },
          "basis": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "explanation": {"type": "string", "maxLength": 500}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "values", "source_urls"],
        "properties": {
          "field": {"type": "string"},
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {"$ref": "#/$defs/scalar"}
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "publish"}},
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "manufacturer",
          "manufacturer_zh",
          "model",
          "product_category_code",
          "product_category",
          "product_type",
          "summary"
        ],
        "anyOf": [
          {"required": ["product_description_zh"]},
          {"required": ["display_title_zh"]}
        ],
        "properties": {
          "manufacturer": {"minLength": 1},
          "manufacturer_zh": {"minLength": 1},
          "model": {"minLength": 1},
          "product_description_zh": {"minLength": 1},
          "display_title_zh": {"minLength": 1},
          "product_type": {"minLength": 1},
          "summary": {"minLength": 1},
          "datasheets": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": ["no_datasheet", "ambiguous", "insufficient_identity"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "datasheet_parameters": {"maxItems": 0},
          "facts": {"maxItems": 0},
          "derived_insights": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "out_of_scope"}},
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "product_category",
          "summary",
          "classification_evidence_urls",
          "classification_evidence_quotes"
        ],
        "properties": {
          "summary": {"minLength": 1},
          "classification_evidence_urls": {"minItems": 1},
          "classification_evidence_quotes": {"minItems": 1},
          "datasheets": {"maxItems": 0},
          "sources": {"maxItems": 0},
          "datasheet_parameters": {"maxItems": 0},
          "facts": {"maxItems": 0},
          "derived_insights": {"maxItems": 0},
          "conflicts": {"maxItems": 0}
        }
      }
    }
  ]
}
