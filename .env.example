# PostgreSQL read-only source. Never commit real values.
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=products
PGUSER=products_readonly
PGPASSWORD=replace-me
# Prefer certificate and hostname verification. For an accepted internal
# certificate limitation, require encrypts but does not verify identity.
PGSSLMODE=verify-full

# Tavily - multi-key rotation (comma or whitespace separated).
# Falls back to single TAVILY_API_KEY if TAVILY_API_KEYS is unset.
TAVILY_API_KEYS=tvly-key1,tvly-key2
# TAVILY_API_KEY=tvly-single-key

# Existing Wiki.js 2.5 instance
WIKIJS_URL=https://wiki.example.com
WIKIJS_TOKEN=replace-me
WIKIJS_LOCALE=en
WIKIJS_PATH_PREFIX=products
WIKIJS_HOME_PATH=home
WIKIJS_HOME_TITLE=PV Wiki
# Safe defaults: new pages are private drafts. Existing page visibility is kept.
WIKIJS_NEW_PAGE_PRIVATE=true
WIKIJS_NEW_PAGE_PUBLISHED=false

# Local durable state (mount this path persistently in containers)
PV_WIKI_STATE_PATH=~/.hermes/data/pv-wiki/state.sqlite3
PV_WIKI_AUTO_PUBLISH_MIN_CONFIDENCE=0.85
PV_WIKI_MIN_FACT_CONFIDENCE=0.80
PV_WIKI_ALLOW_MIRRORS=false
PV_WIKI_TAVILY_INCLUDE_INTERNAL_HINTS=false
PV_WIKI_MAX_EXTRACT_CHARS=30000
PV_WIKI_HTTP_TIMEOUT=30
