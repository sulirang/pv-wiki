# PostgreSQL read-only source. Never commit real values.
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=products
PGUSER=products_readonly
PGPASSWORD=
# Prefer certificate and hostname verification. Explicit disable/allow/prefer
# are supported only when the catalogue server cannot use TLS and the operator
# accepts the resulting network risk.
PGSSLMODE=verify-full

# Exa bounded web research. Multiple keys may be comma/whitespace separated;
# the singular variable remains available for one-key deployments.
EXA_API_KEYS=
# EXA_API_KEY=exa-single-key

# User-selected OpenAI-compatible Chat Completions API.
# AI_BASE_URL is the API base path; the worker adds /chat/completions.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=
AI_ALLOW_INSECURE_HTTP=false
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096
AI_MAX_EVIDENCE_CHARS=80000

# Existing Wiki.js 2.5 instance
WIKIJS_URL=https://wiki.example.com
WIKIJS_TOKEN=
WIKIJS_LOCALE=en
WIKIJS_PATH_PREFIX=products
WIKIJS_HOME_PATH=home
WIKIJS_HOME_TITLE=PV Wiki
# Safe defaults: new pages are private drafts. Existing page visibility is kept.
WIKIJS_NEW_PAGE_PRIVATE=true
WIKIJS_NEW_PAGE_PUBLISHED=false

# Local durable state (the Docker deployment overrides this with /data).
PV_WIKI_STATE_PATH=~/.local/state/pv-wiki/state.sqlite3
# Required only by `pv-wiki serve`; use a separate random value of 32+ chars.
PV_WIKI_WORKER_TOKEN=
PV_WIKI_WORKER_HOST=127.0.0.1
PV_WIKI_WORKER_PORT=8080
PV_WIKI_AUTO_PUBLISH_MIN_CONFIDENCE=0.85
PV_WIKI_MIN_FACT_CONFIDENCE=0.80
PV_WIKI_ALLOW_MIRRORS=false
# Optional JSON override/fast path: AI-discovered public manufacturer alias ->
# narrow official/regulatory/authorized hostnames. A legacy brand_code key is
# used only when no public manufacturer has been discovered.
# Without a matching entry, the runtime may automatically verify an HTTPS
# manufacturer host only when it matches the AI-discovered manufacturer and the
# extracted body contains both that manufacturer and the complete product model.
# A second independent HTTPS extract must corroborate the identity, and every
# published fact must have exact supporting quotes from both domains.
# A failed check becomes source_unverified, is retried automatically, and does
# not create a per-product issue or require manual escalation.
PV_WIKI_TRUSTED_SOURCE_DOMAINS_JSON=
PV_WIKI_SEARCH_INCLUDE_INTERNAL_HINTS=false
PV_WIKI_MAX_EXTRACT_CHARS=30000
# One /run-one call may perform an initial research pass plus at most two
# AI-requested supplemental passes. These are hard admission bounds, not
# targets. Normalized budget units must be at least 3 for the fixed initial
# Search; each query reserves 1 and each extract batch reserves 2. Exa's actual
# provider-reported dollar cost is also retained in the audit. The seconds
# value is a no-new-action deadline, with the lease separately covering the
# bounded completion tail.
PV_WIKI_RESEARCH_MAX_ROUNDS=3
PV_WIKI_RESEARCH_MAX_QUERIES=7
PV_WIKI_RESEARCH_MAX_CREDITS=20
PV_WIKI_RESEARCH_MAX_SECONDS=600
PV_WIKI_HTTP_TIMEOUT=30
